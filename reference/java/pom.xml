<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.dizitart</groupId>
    <artifactId>cryptand</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Cryptand</name>
    <description>
        Reference implementation of the Cryptand File Format (CFF v1.0): a cross-language,
        encrypted LSM storage engine and on-disk format for Nitrite.
    </description>
    <url>https://nitrite.dizitart.com/cryptand</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Anindya Chatterjee</name>
            <email>anidotnet@gmail.com</email>
            <organization>Dizitart</organization>
            <organizationUrl>https://nitrite.dizitart.com</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/nitrite/cryptand.git</connection>
        <developerConnection>scm:git:https://github.com/nitrite/cryptand.git</developerConnection>
        <url>https://github.com/nitrite/cryptand.git</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <!--
          17: records, sealed interfaces and pattern matching for instanceof,
          which is what the value model needs. Pattern matching in *switch* is
          21, so the encoders dispatch through instanceof chains instead and
          the compiler does not check them for exhaustiveness. Each such chain
          therefore ends in a throw naming the type it did not handle - a
          runtime check where 21 would have given a compile-time one. Worth
          knowing when adding a CVE type: the build will not tell you where to
          go, the tests will.
        -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
        <jackson.version>2.18.2</jackson.version>
    </properties>

    <!--
      The library itself has NO runtime dependencies, deliberately. A storage
      format that drags a dependency tree into every consumer is a format
      nobody embeds. Everything below is test scope: JUnit, and Jackson only
      to read the shared conformance vectors, which are JSON.
    -->
    <dependencies>
        <!--
          Comparison-benchmark only, and `test` scope so neither reaches the
          published artifact. `reference/bench/README.md` explains what the
          comparison does and does not claim.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2-mvstore</artifactId>
            <version>2.3.232</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.rocksdb</groupId>
            <artifactId>rocksdbjni</artifactId>
            <version>9.10.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <!--
              Coverage. Bound to the default phases so `mvn test` writes
              target/site/jacoco/jacoco.xml and `mvn verify` fails the build if
              the ratchet below is not met. The interop entry point is
              excluded: it is driven by reference/conformance/interop/run.sh
              and not by the suite, so counting it measures the harness rather
              than the engine. The benchmarks need no exclusion any more: they
              are test-scope, so jacoco never sees them and neither does the
              published jar.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <configuration>
                    <excludes>
                        <exclude>org/dizitart/cryptand/tool/Interop*</exclude>
                        <exclude>org/dizitart/cryptand/text/UnicodeTables*</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
